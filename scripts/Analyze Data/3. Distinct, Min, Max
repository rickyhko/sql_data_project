-- explore countries, category 	

SELECT DISTINCT country FROM dim_customers;

SELECT DISTINCT 
	category, 
	sub_category, 
    product_name FROM dim_product
ORDER BY 1,2,3;

-- find the date of the first and last order

SELECT 
	MIN(order_date) first_order_date,
	MAX(order_date) last_order_date,
	TIMESTAMPDIFF(YEAR, MIN(order_date), MAX(order_date)) order_range_month
FROM gold.fact_sales;

-- find youngest and oldest customer
SELECT
	MIN(birth_date) older_birth_date,
    TIMESTAMPDIFF(year, MIN(birth_date), CURDATE()) oldest_age,
	MAX(birth_date) youngest_birth_date,
    TIMESTAMPDIFF(year, MAX(birth_date), CURDATE()) oldest_age
    FROM gold.dim_customer;

SELECT *
FROM gold.dim_customer;
